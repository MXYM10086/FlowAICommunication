<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only. Permits cleartext HTTP to addresses that cannot leave the local network, so a
  developer can point the app at a relay running on their own machine and exercise the remote path.

  Release builds do not reference this file and the app refuses to send conversation text over
  cleartext, because that text is private.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.0.0</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.2.189</domain>
    </domain-config>
</network-security-config>
