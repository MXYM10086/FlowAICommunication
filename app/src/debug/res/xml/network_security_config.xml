<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug only. Permits cleartext HTTP so a developer can point the app at a relay running on their
  own machine and exercise the remote path.

  Release builds do not reference this file, and the app additionally refuses cleartext to any
  address outside the private ranges (see RemoteLlmService), because conversation text is private.
  No specific host is listed here: a developer's own address does not belong in the repository.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
