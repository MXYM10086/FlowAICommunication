<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- API 31 backup rules are ignored on older devices; fullBackupContent covers those. -->
    <!--
      Floating assistant entry point (V2). SYSTEM_ALERT_WINDOW is a special permission: it is
      granted on a dedicated Settings screen, never through the runtime dialog. The overlay only
      provides an entry point; it captures nothing by itself.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required for the specialUse foreground service type used by the floating bubble. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Screenshot capture (V2). Android 14 requires this permission AND the service type below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <application android:allowBackup="false" android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher" android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31" android:label="FlowAI Communication"
        android:theme="@style/Theme.FlowAI" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Share sheet entry. Advertised as broadly as possible because senders differ and some
              (WeChat among them) would not surface the app under a narrower declaration:
                1. */*         — matches any declared MIME type, including text/plain and text/html.
                2. text/*      — kept explicitly for clarity/redundancy.
                3. no <data>   — matches intents that never called setType() (type == null).
                4. SEND_MULTIPLE — sharing several items; the payload may be a String array or list.
              Advertising broadly only affects visibility in the share sheet: SharedText.resolve
              still rejects anything that carries no usable text, so non-text shares are ignored.
            -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data />
            </intent-filter>
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data />
            </intent-filter>
            <!--
              Selection-toolbar entry (Android 6.0+): the user selects text in ANY app — including
              chat apps that never expose a share action for it — and picks FlowAI right from the
              floating selection toolbar. Closer to the "understand this conversation" intent than
              sharing a single message, and it needs no extra permission.
            -->
            <intent-filter android:label="@string/process_text_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!--
          Foreground service hosting the floating bubble. Not exported: only this app starts it.
          specialUse is declared because the bubble is a user-invoked entry point that does not fit
          the media/location/data-sync categories.
        -->
        <service
            android:name=".system.FloatingAssistantService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-invoked floating entry point for the communication assistant" />
        </service>
        <!--
          Screenshot capture. Declared as a mediaProjection foreground service because Android 14
          requires the type AND that startForeground happen before getMediaProjection(). Not
          exported: consent data comes only from this app's own Activity.
        -->
        <service
            android:name=".system.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <!--
          Region picker. Theme.NoDisplay is wrong here (it must stay visible to pick from), but it
          is translucent so the app underneath is not destroyed, and excluded from recents.
        -->
        <activity
            android:name=".system.RegionPickerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.FlowAI.RegionPicker" />
    </application>
</manifest>
