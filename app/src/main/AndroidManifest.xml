<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- API 31 backup rules are ignored on older devices; fullBackupContent covers those. -->
    <!--
      Floating assistant entry point (V2). SYSTEM_ALERT_WINDOW is a special permission: it is
      granted on a dedicated Settings screen, never through the runtime dialog. The overlay only
      provides an entry point; it captures nothing by itself.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required for the specialUse foreground service type used by the floating bubble. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Screenshot capture (V2). Android 14 requires this permission AND the service type below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <application android:allowBackup="false" android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher" android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="${networkSecurityConfig}"
        tools:targetApi="31" android:label="FlowAI Communication"
        android:theme="@style/Theme.FlowAI" android:supportsRtl="true">
        <!--
          No singleTask: with it, the selection entry point gets merged into this task and drags the
          whole app to the front, so the panel would appear over FlowAI instead of over the app the
          user was reading. Shared text arrives through onCreate/onNewIntent either way.
        -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Share sheet entry. Advertised as broadly as possible because senders differ and some
              (WeChat among them) would not surface the app under a narrower declaration:
                1. */*         — matches any declared MIME type, including text/plain and text/html.
                2. text/*      — kept explicitly for clarity/redundancy.
                3. no <data>   — matches intents that never called setType() (type == null).
                4. SEND_MULTIPLE — sharing several items; the payload may be a String array or list.
              Advertising broadly only affects visibility in the share sheet: SharedText.resolve
              still rejects anything that carries no usable text, so non-text shares are ignored.
            -->
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data />
            </intent-filter>
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter android:label="@string/share_target_label">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data />
            </intent-filter>
            <!--
              Selection-toolbar entry (Android 6.0+). Declared on SelectionEntryActivity rather than
              here so the selection opens the in-place panel over the app the user is reading,
              instead of pulling the whole app to the front.
            -->
        </activity>
        <!--
          Selection-toolbar entry point. Translucent and UI-less: it forwards the selected text to
          the floating panel and finishes, so the user stays in the app they were reading.
        -->
        <activity
            android:name=".system.SelectionEntryActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.FlowAI.RegionPicker">
            <intent-filter android:label="@string/process_text_label">
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!--
          Foreground service hosting the floating bubble. Not exported: only this app starts it.
          specialUse is declared because the bubble is a user-invoked entry point that does not fit
          the media/location/data-sync categories.
        -->
        <service
            android:name=".system.FloatingAssistantService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-invoked floating entry point for the communication assistant" />
        </service>
        <!--
          Screenshot capture. Declared as a mediaProjection foreground service because Android 14
          requires the type AND that startForeground happen before getMediaProjection(). Not
          exported: consent data comes only from this app's own Activity.
        -->
        <service
            android:name=".system.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <!--
          Region picker. Theme.NoDisplay is wrong here (it must stay visible to pick from), but it
          is translucent so the app underneath is not destroyed, and excluded from recents.
        -->
        <activity
            android:name=".system.RegionPickerActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.FlowAI.RegionPicker" />
        <!--
          Capture started from the assistant panel. Translucent so the app being captured stays
          visible; the panel hides itself first so the overlay is not part of the frame.
        -->
        <activity
            android:name=".system.CaptureForPanelActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.FlowAI.RegionPicker" />
    </application>
</manifest>
