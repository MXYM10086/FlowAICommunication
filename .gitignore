.idea/
**/build/
local.properties
*.iml
.tools/

# APKs are build outputs, not sources. Rebuild them from source instead of committing.
# Release artifacts are attached to a tag/release, not tracked in the working tree.
*.apk
*.apk.sha256

# 临时提交信息文件
.commitmsg*.tmp
.git-commit-msg.tmp
.gitmsg
.gm

