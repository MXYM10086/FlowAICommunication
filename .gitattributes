# Normalize to LF in the repository so the checkout is identical across platforms.
# Critical for `gradlew` (a shell script) and for the Kotlin/XML sources.
* text=auto eol=lf

# Windows-only launchers keep CRLF, which cmd.exe expects.
*.bat text eol=crlf

# Binary assets must never be line-ending converted.
*.png binary
*.jar binary
*.apk binary
*.sha256 binary
